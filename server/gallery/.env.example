# Set these as hosting secrets. Never publish a real .env or OAuth JSON.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=
# Exact origins, without trailing slash. Local origins are for local testing only.
ALLOWED_ORIGINS=https://samsvadba.github.io
PUBLIC_API_URL=https://YOUR-GALLERY-HOST/api/gallery
PORT=8080
HOST=0.0.0.0
# Number of verified trusted reverse proxies (0-8); never guess. See README.
TRUST_PROXY_HOPS=0
# Optional invite code, not a Google credential. Anyone given it can share it.
GALLERY_INVITE_KEY=
# Optional platform-specific mounted secret file created by setup script.
# GOOGLE_OAUTH_CREDENTIALS=/private/path/client_secret.json
